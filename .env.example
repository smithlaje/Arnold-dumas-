# Cadena de conexión a PostgreSQL (Railway/Render la generan automáticamente)
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# Clave secreta para firmar los tokens de sesión — usa un valor largo y aleatorio en producción
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

PORT=3000

# Datos del primer usuario administrador, usados solo por el script de seed (npm run seed)
ADMIN_EMAIL="admin@tuempresa.com"
ADMIN_PASSWORD="CambiaEstaClave123"
ADMIN_NOMBRE="Administrador"
